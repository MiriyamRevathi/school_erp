{
  "name": "greenfield-school-erp",
  "version": "2.4.0",
  "private": true,
  "description": "Greenfield International School - Enterprise Multi-Tenant School ERP & Academic Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && node dist/main.js",
    "start:frontend": "cd frontend && npm run start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "test": "cd backend && npm test",
    "lint": "cd frontend && npm run lint"
  },
  "keywords": [
    "school-erp",
    "education-management",
    "academics",
    "attendance",
    "grading",
    "fee-management",
    "nestjs",
    "nextjs",
    "typescript"
  ],
  "author": "Greenfield International School ICT Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
